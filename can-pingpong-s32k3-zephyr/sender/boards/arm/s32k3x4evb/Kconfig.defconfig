if BOARD_S32K3X4EVB

config BOARD
	default "s32k3x4evb"

if SERIAL

config UART_CONSOLE
	default y

endif # SERIAL

if SPI

config SPI_INIT_PRIORITY
	default 50

if WDT_NXP_FS26

config WDT_NXP_FS26_INIT_PRIORITY
	default 51

endif # WDT_NXP_FS26
endif # SPI

if NETWORKING

config NET_L2_ETHERNET
	default y if !NET_LOOPBACK && !NET_TEST

config MDIO
	default y if NET_L2_ETHERNET

endif # NETWORKING

endif # BOARD_S32K3X4EVB
